# Local-only development. Run pnpm run setup once to generate ignored secrets.
# Provision these roles/database separately; setup does NOT create them.
# API/worker: restricted mask_app role. Migration tooling: separate privileged role.
# Replace the database port with your approved native PostgreSQL service port.
MASK_DATABASE_URL=postgresql+psycopg://mask_app:__GENERATE_APP_PASSWORD__@127.0.0.1:5433/mask
MASK_MIGRATION_DATABASE_URL=postgresql+psycopg://mask_migrator:__GENERATE_ADMIN_PASSWORD__@127.0.0.1:5433/mask
MASK_ENVIRONMENT=development
# Required only for local smoke-job endpoints; never sent to the web browser.
MASK_DEV_TOKEN=__GENERATE_DEV_TOKEN__
MASK_ENABLE_DEV_ROUTES=true
MASK_LOG_LEVEL=INFO
MASK_QUEUE_POLL_SECONDS=1
MASK_JOB_LEASE_SECONDS=30
MASK_WORKER_HEARTBEAT_SECONDS=5
MASK_WORKER_STALE_SECONDS=15
MASK_AUTH_SESSION_HOURS=8
MASK_AUTH_FAILURE_LIMIT=5
MASK_AUTH_LOCKOUT_SECONDS=900
MASK_AUTH_RECENT_MINUTES=15
# Next.js SERVER-ONLY API address. Shell-export non-default values for the web.
MASK_API_BASE_URL=http://127.0.0.1:8000
# Integration tests target the local API.
MASK_TEST_API_URL=http://127.0.0.1:8000
