{
  "name": "@mask/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format:check": "prettier --check src next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts tsconfig.json components.json package.json",
    "format": "prettier --write src next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts tsconfig.json components.json package.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=../../reports/web-unit.xml"
  },
  "dependencies": {
    "@mask/schemas": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "radix-ui": "1.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "@types/node": "24.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "vitest": "4.1.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  }
}
